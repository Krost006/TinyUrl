# Шаблон настроек. Скопируйте в .env и подставьте свои значения:
#
#     cp .env.example .env
#
# Сам .env в git не попадает — в нём секреты.

# Ключ подписи JWT. Сгенерировать:
#     openssl rand -base64 32
# Смена ключа делает все выданные токены недействительными.
JWT_SECRET=

# Пароль пользователя базы. Задаётся при первом создании тома pgdata;
# чтобы сменить позже, нужно либо ALTER USER внутри базы, либо пересоздать
# том через docker compose down -v (данные при этом теряются).
POSTGRES_PASSWORD=

# Внешний адрес, по которому доступны короткие ссылки, — то есть сервис
# редиректов. Из него же берётся хост для проверки самоссылок.
# Локально:  http://localhost:8091
# На сервере: http://<адрес сервера>:<порт nginx для редиректа>
BASE_URL=http://localhost:8091

# Порты на хосте. Меняйте, если заняты другими сервисами:
#     ss -lntp | grep -E ':(8090|8091)'
API_PORT=8090
REDIRECT_PORT=8091
